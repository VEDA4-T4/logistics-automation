[mqtt]
host=mqtt.logistics.local
port=8883
client_id=central-server
username=central-server
password=replace-with-central-server-mqtt-password
tls_enabled=true
ca_certificate=/etc/logistics/tls/ca.crt
keep_alive_seconds=30
reconnect_min_delay_seconds=1
reconnect_max_delay_seconds=30
# Keep the broker session so QoS 1 messages can be delivered after a server restart.
clean_session=false

[device_registry]
# Relative paths are resolved from this server.ini file.
path=devices.json

[database]
path=/var/lib/logistics/logistics.db
migration_dir=/usr/share/logistics/migrations
busy_timeout_ms=5000
# fresh recreates the database before migrations and copies only product_catalog; resume preserves all state.
startup_mode=fresh

[storage]
image_root=/var/lib/logistics/images
cleanup_interval_hours=24
mqtt_retention_days=30
device_status_retention_days=30
error_retention_days=180
security_retention_days=180
image_retention_days=30
upload_retention_days=30

[http]
enabled=true
port=8080
tls_enabled=false
tls_certificate=/etc/logistics/tls/server.crt
tls_private_key=/etc/logistics/tls/server.key
bearer_token=replace-with-a-device-upload-token
upload_root=/var/lib/logistics/uploads

[routing]
# Must match control-center [mqtt] client_id.
qt_client_id=control-center

[process]
# Automatic orchestration is the normal operating mode.
enabled=true
server_id=central-server
input_device_id=PI-INPUT-01
vision_device_id=PI-VISION-01
gripper_device_id=PI-GRIPPER-01
sorting_device_id=PI-SORTING-01
line_tracer_device_id=PI-LT-01
line_tracer_enabled=true
# Physical parking position used when initializing the line tracer.
# Allowed values: A, B, C
line_tracer_initial_position=A
# Product-catalog misses are routed here instead of stalling the work.
default_destination=3

[sensor_detection]
# Box presence is decided here, from the distanceCm the STM32 reports.
# The controller does not judge DETECTED/CLEAR any more, so these values are
# the only place detection is tuned - no firmware rebuild required.
enabled=true
# A reading at or below enter_threshold_cm starts a box.
enter_threshold_cm=15
# The box is only released once the reading climbs above exit_threshold_cm.
# Must be >= enter_threshold_cm; the gap is the hysteresis band that stops
# DETECTED/CLEAR from chattering when a box parks near the limit.
exit_threshold_cm=15
# Consecutive agreeing readings required before the state flips.
debounce_count=3

[homography]
# Keep disabled until pixel_to_conveyor is replaced with a matrix measured for the installed camera.
enabled=false
# Row-major 3x3 matrix: [u, v, 1] camera pixels -> [x, y, w] conveyor millimetres.
pixel_to_conveyor=1,0,0,0,1,0,0,0,1
# Conveyor top plane and gripper base origin, all in the same installation coordinate system.
conveyor_plane_z_mm=850
robot_base_x_mm=1250
robot_base_y_mm=430
robot_base_z_mm=0
# Counter-clockwise rotation from the conveyor X axis to the gripper-base X axis.
robot_base_yaw_deg=90
coordinate_frame=PI-GRIPPER-01_BASE
# Physical box dimensions used for the top-centre grasp target.
box_length_mm=400
box_width_mm=300
box_height_mm=250
calibration_version=1
