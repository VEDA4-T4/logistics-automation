# Copy this file to logistics-wifi.conf on the SD card Boot partition.
# Replace the SSID and passphrase before the first boot.
# The provisioning service removes logistics-wifi.conf after importing it.

ctrl_interface=/run/wpa_supplicant
update_config=0
country=KR

# Support both SAE H2E and the legacy SAE method.
sae_pwe=2

network={
    ssid="REPLACE_WITH_WIFI_SSID"
    psk="REPLACE_WITH_WIFI_PASSWORD"

    # Supports WPA2-Personal, WPA3-Personal and transition mode.
    key_mgmt=WPA-PSK SAE
    ieee80211w=1

    # Also scan for hidden SSIDs.
    scan_ssid=1
}
