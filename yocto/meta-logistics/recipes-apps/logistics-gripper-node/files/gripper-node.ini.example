[device]
device_id=PI-GRIPPER-01
node_name=gripper-node-01
ip_address=192.0.2.24

[mqtt]
host=mqtt.logistics.local
port=8883
client_id=PI-GRIPPER-01
username=PI-GRIPPER-01
password=replace-with-gripper-mqtt-password
tls_enabled=true
ca_certificate=/etc/logistics/tls/ca.crt
keep_alive_seconds=30
reconnect_min_delay_seconds=1
reconnect_max_delay_seconds=30
clean_session=false
publish_spool_directory=/var/lib/logistics/mqtt-spool
publish_spool_maximum_bytes=52428800
publish_spool_maximum_records=4096

[log_upload]
enabled=false

[gripper]
# Taught arm poses: base,shoulder,elbow in deci-degrees.
home_pose=1000,700,1200
pick_approach_pose=1000,1300,1400
pick_pose=1000,1000,1300
pick_lift_pose=1000,600,1400
transfer_pose=1800,600,1400
place_approach_pose=1800,1100,1500
place_pose=1800,700,1200

# Calibrated claw travel for the assembled mechanism.
open_position_percent=65
closed_position_percent=50
arm_duration_ms=1500
claw_duration_ms=600

# Optional Vision horizontal-offset correction; 0 disables it.
base_deci_deg_per_pixel=0.0
max_base_correction_deci_deg=150

# Arm geometry in millimetres and servo reference calibration.
link_shoulder_to_elbow_mm=85.0
link_elbow_to_tcp_mm=175.0
shoulder_height_mm=20.0
shoulder_offset_mm=0.0
base_zero_deci_deg=900.0
shoulder_zero_deci_deg=900.0
elbow_zero_deci_deg=1800.0
base_direction=1
shoulder_direction=1
elbow_direction=1
approach_height_mm=60.0
min_target_z_mm=0.0

# Mirror the STM32 limits in gripper_calibration.h.
base_min_deci_deg=100
base_max_deci_deg=1800
shoulder_min_deci_deg=300
shoulder_max_deci_deg=1500
elbow_min_deci_deg=300
elbow_max_deci_deg=1800
base_max_speed_deci_deg_per_sec=300
shoulder_max_speed_deci_deg_per_sec=120
elbow_max_speed_deci_deg_per_sec=200
claw_max_speed_percent_per_sec=40
home_claw_percent=65
