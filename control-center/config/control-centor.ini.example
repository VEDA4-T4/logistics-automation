; Copy this file to config/control-centor.ini and replace the example values.
; Do not commit control-centor.ini because it can contain credentials.

[mqtt]
host=mqtt.logistics.local
port=8883
client_id=control-center
username=control-center
password=replace-with-control-center-mqtt-password
tls_enabled=true
ca_certificate=C:/ProgramData/Logistics/tls/ca.crt
reconnect_interval_ms=3000
keep_alive_seconds=30

[control]
; Initial GUI selection. Click the top SYSTEM/process cards to change the target at runtime.
; Emergency stop is always sent to SYSTEM regardless of this selection.
target_device_id=SYSTEM

[dashboard]
; Map each independently operating process to the sourceId used by its device node.
input_device_id=PI-INPUT-01
vision_device_id=PI-VISION-01
; The gripper only transfers a product between conveyors; it does not rotate the product.
gripper_device_id=PI-GRIPPER-01
sorting_device_id=PI-SORTING-01
linetracer_device_id=PI-LT-01

[http]
; Relative image paths from MQTT are resolved against this central-server URL.
image_base_url=http://central-server.logistics.local:8080/
; Optional. When set, the operations log loads older entries from /api/v1/history.
; Use the same value as the central server's [http] bearer_token.
bearer_token=

[logs]
; Shared maximum for the live log buffer and rows retained by the operations log table.
; Valid range: 100-500.
max_buffer_entries=500

[rtsp]
reconnect_interval_ms=3000
; Video RTP is forced over the RTSP TCP control connection.
transport=tcp
; Qt 6.10+ FFmpeg decoder: reduce playback buffering for live monitoring.
; Disable this when smooth playback is more important than latency.
low_latency=true
; RTSP response or video packet timeout. A timeout is handled by the reconnect flow.
network_timeout_ms=3000
; FFmpeg startup analysis size. Smaller starts faster but can miss uncommon stream details.
probe_size_bytes=32768
; Drop queued dependent frames and wait for the next IDR when this input limit is exceeded.
max_buffer_size_bytes=2097152
; Subscribe to the ONVIF XML metadata track and draw detections over the video.
onvif_metadata_enabled=true
; Print received ONVIF XML and parsed detections to Qt Creator Application Output.
; Enable only while diagnosing because per-frame logs can delay the UI.
onvif_log_payload=false
; Remove boxes when no newer metadata frame arrives within this time.
metadata_stale_timeout_ms=1500

; Qt connects directly to each CCTV RTSP stream. RTSP is not encrypted; use a trusted LAN or VPN.
; Keep real credentials only in control-centor.ini.
; Replace cctv-user/cctv-password and percent-encode reserved password characters.
channel_1_url=rtsp://cctv-user:cctv-password@veda4-t4.iptime.org:8554/profile2/media.smp
; Leave channel_1_metadata_url unset when video and ONVIF metadata use the same CCTV endpoint.

[danger_zone]
; Rectangles use normalized video coordinates: x,y,width,height. Separate multiple regions with semicolons.
regions=
overlay_visible=true
person_classes=Head,Face,Human
minimum_confidence=0.5

[ui]
language=ko_KR
