# Copy this file to input-node.ini before running the input node.
# Do not commit input-node.ini because it can contain deployment IP addresses
# and MQTT credentials.

[device]
# Must match the targetDeviceId used by the central server.
device_id=PI-INPUT-01

# Human-readable node name reported during device registration.
node_name=input-node-01

# Replace with the input Raspberry Pi IP address shown by `hostname -I`.
ip_address=192.0.2.23

[mqtt]
# Replace with the central server/MQTT broker IP address or resolvable hostname.
# The value must appear in the broker certificate subjectAltName.
host=mqtt.logistics.local
port=8883

# Must be unique among clients connected to the same MQTT broker. A duplicate
# client_id makes the broker drop both peers, which looks identical to an ACL
# rejection in the daemon log.
client_id=PI-INPUT-01

# Leave both values empty only when the MQTT broker permits anonymous access.
username=PI-INPUT-01
password=replace-with-input-mqtt-password

# Connection recovery policy. The defaults normally do not need adjustment.
tls_enabled=true
ca_certificate=/etc/logistics/tls/ca.crt
keep_alive_seconds=30
reconnect_min_delay_seconds=1
reconnect_max_delay_seconds=30
clean_session=true

[log_upload]
# The input node does not upload logs; journald keeps them on the device.
enabled=false
