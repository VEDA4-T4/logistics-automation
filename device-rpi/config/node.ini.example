[device]
device_id=PI-TEST
node_name=vision-node-01
ip_address=192.168.0.21

[mqtt]
host=127.0.0.1
port=1883
client_id=PI-TEST
username=
password=
keep_alive_seconds=30
reconnect_min_delay_seconds=1
reconnect_max_delay_seconds=30
clean_session=true

[log_upload]
enabled=true
endpoint_url=http://127.0.0.1:8080/api/v1/uploads/logs
bearer_token=replace-with-a-device-upload-token
ca_certificate=/etc/logistics/tls/ca.crt
spool_directory=/var/lib/logistics/log-spool
rotate_bytes=5242880
rotate_interval_seconds=3600
maximum_spool_bytes=104857600
request_timeout_seconds=30
maximum_attempts=5
initial_backoff_seconds=1
maximum_backoff_seconds=60
allow_insecure_http=true

[image_upload]
enabled=true
endpoint_url=http://127.0.0.1:8080/api/v1/uploads/images
bearer_token=replace-with-a-device-upload-token
ca_certificate=/etc/logistics/tls/ca.crt
request_timeout_seconds=30
maximum_attempts=5
initial_backoff_seconds=1
maximum_backoff_seconds=60
allow_insecure_http=true

[vision_processing]
# The production path always tries the original frame first. Expensive fallback
# processing starts only after the configured number of consecutive failures.
perspective_rectification=true
contrast_enhancement=true
super_resolution_enabled=true
barcode_detection_fallback=true
barcode_decode_fallback=true
super_resolution_backend=bicubic
super_resolution_scale=2
failure_frames_before_super_resolution=2
maximum_super_resolution_input_pixels=300000
failure_frame_capture_enabled=true
failure_frame_directory=/tmp/logistics-vision-failures
maximum_failure_frames=200
failure_frame_jpeg_quality=90

# To use a learned FSRCNN model, change the backend and place the TensorFlow
# .pb file relative to this configuration file (or specify an absolute path).
# super_resolution_backend=fsrcnn
# super_resolution_model_path=models/FSRCNN_x2.pb
