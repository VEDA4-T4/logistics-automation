[device]
device_id=PI-TEST
node_name=vision-node-01
ip_address=192.168.0.21

[mqtt]
host=127.0.0.1
port=1883
client_id=PI-TEST
username=
password=
keep_alive_seconds=30
reconnect_min_delay_seconds=1
reconnect_max_delay_seconds=30
clean_session=true

[log_upload]
enabled=true
endpoint_url=http://127.0.0.1:8080/api/v1/uploads/logs
bearer_token=replace-with-a-device-upload-token
ca_certificate=/etc/logistics/tls/ca.crt
spool_directory=/var/lib/logistics/log-spool
rotate_bytes=5242880
rotate_interval_seconds=3600
maximum_spool_bytes=104857600
request_timeout_seconds=30
maximum_attempts=5
initial_backoff_seconds=1
maximum_backoff_seconds=60
allow_insecure_http=true
