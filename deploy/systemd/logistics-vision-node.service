[Unit]
Description=Logistics Vision Node
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=logistics
Group=logistics
SupplementaryGroups=video render
WorkingDirectory=/var/lib/logistics

ExecStart=/opt/logistics-automation/bin/logistics_vision_node --headless --config /etc/logistics/vision-node.ini

KillSignal=SIGTERM
TimeoutStopSec=20

Restart=on-failure
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=logistics-vision-node

NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
