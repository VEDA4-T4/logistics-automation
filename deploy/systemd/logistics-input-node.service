[Unit]
Description=Logistics Input Node
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=logistics
Group=logistics
SupplementaryGroups=dialout
WorkingDirectory=/var/lib/logistics

ExecStart=/opt/logistics-automation/bin/logistics_input_node /etc/logistics/input-node.ini /dev/vedauart

KillSignal=SIGTERM
TimeoutStopSec=20

Restart=on-failure
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=logistics-input-node

NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
