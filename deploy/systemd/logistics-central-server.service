[Unit]
Description=Logistics Central Server
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=logistics
Group=logistics
StateDirectory=logistics
StateDirectoryMode=0750
WorkingDirectory=/var/lib/logistics
ExecStart=/opt/logistics-automation/bin/logistics_central_server --config /etc/logistics/server.ini

KillSignal=SIGTERM
TimeoutStopSec=20

Restart=on-failure
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=logistics-central-server

NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
